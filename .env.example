# FloodWatch API — environment variables
# Copy to .env and fill in real values:  cp .env.example .env

# MongoDB connection string (required). The database name is taken from the
# URI path (e.g. .../finalyearDB). Use an Atlas SRV string or a local mongod.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finalyearDB?retryWrites=true&w=majority

# Live simulator — generates fresh sensor readings so the dashboard is live.
# Set to false to run on seeded/ingested data only.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=5

# Comma-separated list of allowed browser origins for CORS.
# Any *.vercel.app origin is always allowed in addition to these.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Identity used in generated CAP alerts.
ALERT_SENDER=floodwatch@unilag.edu.ng

# Optional: override the HTTP port (deploy hosts like Render inject $PORT and
# the start command passes it explicitly, so this is rarely needed locally).
# PORT=8000
